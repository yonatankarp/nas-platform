{#
  One template, rendered once per credential group, because the vault is one
  committed file per service since #612 and a single flat file is the one
  artifact tests/policy_vault_test.rb refuses outright (#641).
  generate-secrets.yml loops `vault_plain_groups` over this file with
  `vault_plain_group` set, and each rendering emits exactly that group's keys.

  It stays a single file rather than eighteen because every key in the vault
  contract is written here exactly once, and that is what
  tests/policy_vault_test.rb reads to hold this template, vault.yml.example, the
  vault_contract argument specs and the ephemeral generator to one key set.
  Eighteen files would leave that parity reading whichever file kept the name.

  Every `vault_` key therefore starts at column 0, inside its section or not:
  tests/managed_users_vault_test.rb collects the eight managed-user lines with an
  anchored grep and parses them as one mapping, and a mutation row in
  tests/policy_manifest_test.rb deletes an anchored key line. Indenting a section
  to match its `{% if %}` would silently take those keys out of every reader.
#}
---
# Brand-new-platform credentials for {{ vault_plain_group }}, generated by
# generate-secrets.yml. Encrypt this file in place and drop the `-plain` suffix
# so it lands at the name group_vars loads and the gate requires:
# inventory/group_vars/all/vault_{{ vault_plain_group }}.yml
#
# This file is not a recovery tool: existing values come from the password
# manager and the deployed configuration and must never be rotated implicitly.
{% if vault_plain_group == 'audiobookshelf' %}

vault_audiobookshelf_admin_username: {{ audiobookshelf_admin_username }}
vault_audiobookshelf_admin_password: {{ audiobookshelf_admin_password }}

# Brand-new installations start without secondary application users. Add
# reviewed identities later through the encrypted-vault workflow.
vault_managed_audiobookshelf_users: []
{% elif vault_plain_group == 'dozzle' %}

vault_dozzle_admin_username: {{ dozzle_admin_username }}
vault_dozzle_admin_password: {{ dozzle_admin_password }}
vault_dozzle_admin_password_hash: "{{ dozzle_admin_password_hash }}"
{# Not an ntfy credential and deliberately not the ntfy publish token: Dozzle
   stores this one at rest in its own /data volume and serves it back over its
   API, so it is minted separately and reveals nothing about ntfy (#172). #}
vault_dozzle_alert_relay_token: {{ dozzle_alert_relay_token | to_json }}

vault_managed_dozzle_users: []
{% elif vault_plain_group == 'immich' %}

vault_immich_admin_email: {{ immich_admin_email }}
vault_immich_admin_password: {{ immich_admin_password }}
vault_immich_db_name: {{ immich_db_name }}
vault_immich_db_username: {{ immich_db_username }}
vault_immich_db_password: {{ immich_db_password }}

vault_managed_immich_users: []
{% elif vault_plain_group == 'jellyfin' %}

vault_jellyfin_admin_username: Yonatan
vault_jellyfin_admin_password: {{ jellyfin_admin_password }}
vault_jellyfin_opensubtitles_username: replace-with-opensubtitles-username
vault_jellyfin_opensubtitles_password: replace-with-opensubtitles-password

vault_managed_jellyfin_users: []
{% elif vault_plain_group == 'komga' %}

vault_komga_admin_email: {{ komga_admin_email }}
vault_komga_admin_password: {{ komga_admin_password }}

vault_managed_komga_users: []
{% elif vault_plain_group == 'arr' %}

vault_arr_radarr_api_key: {{ arr_radarr_api_key | to_json }}
vault_arr_radarr_admin_username: {{ arr_radarr_admin_username }}
vault_arr_radarr_admin_password: {{ arr_radarr_admin_password }}
vault_arr_sonarr_api_key: {{ arr_sonarr_api_key | to_json }}
vault_arr_sonarr_admin_username: {{ arr_sonarr_admin_username }}
vault_arr_sonarr_admin_password: {{ arr_sonarr_admin_password }}
vault_arr_prowlarr_api_key: {{ arr_prowlarr_api_key | to_json }}
vault_arr_prowlarr_admin_username: {{ arr_prowlarr_admin_username }}
vault_arr_prowlarr_admin_password: {{ arr_prowlarr_admin_password }}
vault_arr_bazarr_api_key: {{ arr_bazarr_api_key | to_json }}
vault_arr_bazarr_admin_username: {{ arr_bazarr_admin_username }}
vault_arr_bazarr_admin_password: {{ arr_bazarr_admin_password }}
{% elif vault_plain_group == 'downloaders' %}

vault_downloaders_sabnzbd_api_key: {{ downloaders_sabnzbd_api_key | to_json }}
vault_downloaders_sabnzbd_admin_username: {{ downloaders_sabnzbd_admin_username }}
vault_downloaders_sabnzbd_admin_password: {{ downloaders_sabnzbd_admin_password }}
{# A Usenet provider issues this account to a human subscription; the platform
   cannot generate one, so the stand-ins below are written out for the operator
   to replace before the downloader stack is enabled. #}
vault_downloaders_sabnzbd_server_username: replace-with-usenet-username
vault_downloaders_sabnzbd_server_password: replace-with-usenet-password
{% elif vault_plain_group == 'bindery' %}

vault_bindery_api_key: {{ bindery_api_key | to_json }}
vault_bindery_admin_username: {{ bindery_admin_username }}
vault_bindery_admin_password: {{ bindery_admin_password }}
{% elif vault_plain_group == 'kapowarr' %}

vault_kapowarr_admin_username: {{ kapowarr_admin_username }}
vault_kapowarr_admin_password: {{ kapowarr_admin_password }}
{# ComicVine issues this key to a human account; the platform cannot generate
   one, and the vault contract refuses this stand-in until it is replaced. #}
vault_kapowarr_comicvine_api_key: replace-with-comicvine-api-key
{% elif vault_plain_group == 'pinchflat' %}

vault_pinchflat_admin_username: {{ pinchflat_admin_username }}
vault_pinchflat_admin_password: {{ pinchflat_admin_password }}
{% elif vault_plain_group == 'trailarr' %}

{# WEBUI_PASSWORD is compared with bcrypt.checkpw directly and nothing hashes
   it, so the hash is what Trailarr is given and the plaintext is kept only so
   an operator and the contract can log in. #}
vault_trailarr_api_key: {{ trailarr_api_key | to_json }}
vault_trailarr_admin_username: {{ trailarr_admin_username }}
vault_trailarr_admin_password: {{ trailarr_admin_password }}
vault_trailarr_admin_password_hash: "{{ trailarr_admin_password_hash }}"
{% elif vault_plain_group == 'seerr' %}

{# Seerr needs no administrator password of its own: its owner row is created
   with a Jellyfin user type and no local password, from the Jellyfin
   administrator pair in vault_jellyfin.yml. This one key is the whole of its
   authentication. #}
vault_seerr_api_key: {{ seerr_api_key | to_json }}
{% elif vault_plain_group == 'ntfy' %}

vault_ntfy_admin_user: {{ ntfy_admin_user }}
vault_ntfy_admin_password: {{ ntfy_admin_password }}
vault_ntfy_admin_password_hash: "{{ ntfy_admin_hash }}"
vault_ntfy_dozzle_password_hash: "{{ ntfy_dozzle_hash }}"
vault_ntfy_dozzle_token: {{ ntfy_dozzle_token }}
vault_ntfy_beszel_password_hash: "{{ ntfy_beszel_hash }}"
vault_ntfy_beszel_token: {{ ntfy_beszel_token }}
vault_ntfy_deploy_password_hash: "{{ ntfy_deploy_hash }}"
vault_ntfy_deploy_token: {{ ntfy_deploy_token }}
vault_ntfy_seerr_password_hash: "{{ ntfy_seerr_hash }}"
vault_ntfy_seerr_token: {{ ntfy_seerr_token }}

vault_managed_ntfy_users: []
{% elif vault_plain_group == 'pushover' %}

{# Pushover has no service role of its own -- Beszel, Dozzle and the deployment
   reports all publish through it -- so its keys are their own file rather than
   any service's. The user key and the four application tokens are issued by a
   third-party account, so this generator writes the documented stand-ins for
   the operator to replace rather than values. The credential contract refuses
   every one, so a vault generated and left alone fails before it can deploy a
   notification channel that silently drops. #}
vault_pushover_alerts_token: replace-with-pushover-alerts-token
vault_pushover_containers_token: replace-with-pushover-containers-token
vault_pushover_deployments_token: replace-with-pushover-deployments-token
vault_pushover_media_token: replace-with-pushover-media-token
vault_pushover_user_key: replace-with-pushover-user-key
{% elif vault_plain_group == 'healthchecks' %}

{# The healthchecks.io ping URLs belong to a third-party account as well, and
   to no service at all: the deployment poller reports to them, and it is
   installed by its own play. The contract refuses these stand-ins for the same
   reason it refuses Pushover's. #}
vault_healthchecks_poller_ping_url: replace-with-healthchecks-poller-ping-url
vault_healthchecks_verify_ping_url: replace-with-healthchecks-verify-ping-url
{% elif vault_plain_group == 'beszel' %}

vault_beszel_superuser_email: {{ beszel_superuser_email }}
vault_beszel_superuser_password: {{ beszel_superuser_password }}
vault_beszel_app_user_email: {{ beszel_app_user_email }}
vault_beszel_app_user_password: {{ beszel_app_user_password }}
vault_beszel_agent_key: "{{ beszel_agent_key }}"
vault_beszel_universal_token: {{ beszel_universal_token }}
vault_beszel_hub_private_key: |
{{ beszel_hub_private_key | indent(2, true) }}

vault_managed_beszel_users: []
{% elif vault_plain_group == 'paperless_ngx' %}

vault_paperless_admin_username: {{ paperless_admin_username }}
vault_paperless_admin_password: {{ paperless_admin_password }}
vault_paperless_admin_email: {{ paperless_admin_email }}
vault_paperless_db_name: {{ paperless_db_name }}
vault_paperless_db_username: {{ paperless_db_username }}
vault_paperless_db_password: {{ paperless_db_password }}
vault_paperless_django_secret_key: {{ paperless_django_secret_key }}
vault_paperless_gmail_account: {{ paperless_gmail_account }}
vault_paperless_gmail_app_password: {{ paperless_gmail_app_password }}

vault_managed_paperless_ngx_users: []
{% elif vault_plain_group == 'nextcloud' %}

{# Nextcloud's administrator pair is consumed by the image's entrypoint only
   while the volume holds no version.php, so the first converge is where it is
   decided -- though unlike an account that can never be renamed, occ can reset
   it afterwards. The three database values are PostgreSQL's, and the cache
   password authenticates the Valkey Nextcloud keeps its file locks and sessions
   in. #}
vault_nextcloud_admin_username: {{ nextcloud_admin_username }}
vault_nextcloud_admin_password: {{ nextcloud_admin_password }}
vault_nextcloud_db_name: {{ nextcloud_db_name }}
vault_nextcloud_db_username: {{ nextcloud_db_username }}
vault_nextcloud_db_password: {{ nextcloud_db_password }}
vault_nextcloud_cache_password: {{ nextcloud_cache_password }}
{% else %}
{# A group the play lists but this template has no section for would otherwise
   render a file holding nothing but its header, and `ansible-vault encrypt`
   would make that a perfectly valid, perfectly empty vault_<role>.yml. The
   converge would then fail at vault_contract with keys missing and no file
   admitting it wrote none of them. Refuse at render instead. #}
{{ undef(hint='generate-secrets.yml lists vault group ' ~ vault_plain_group ~
               ', which templates/vault-plain.yml.j2 has no section for') }}
{% endif %}
