---
# Brand-new-platform credentials generated by generate-secrets.yml. This file is
# not a recovery tool: existing values come from the password manager and the
# deployed configuration and must never be rotated implicitly.

vault_audiobookshelf_admin_username: {{ audiobookshelf_admin_username }}
vault_audiobookshelf_admin_password: {{ audiobookshelf_admin_password }}

vault_dozzle_admin_username: {{ dozzle_admin_username }}
vault_dozzle_admin_password: {{ dozzle_admin_password }}
vault_dozzle_admin_password_hash: "{{ dozzle_admin_password_hash }}"

vault_immich_admin_email: {{ immich_admin_email }}
vault_immich_admin_password: {{ immich_admin_password }}
vault_immich_db_name: {{ immich_db_name }}
vault_immich_db_username: {{ immich_db_username }}
vault_immich_db_password: {{ immich_db_password }}

vault_jellyfin_admin_username: Yonatan
vault_jellyfin_admin_password: {{ jellyfin_admin_password }}
vault_jellyfin_opensubtitles_username: replace-with-opensubtitles-username
vault_jellyfin_opensubtitles_password: replace-with-opensubtitles-password

vault_komga_admin_email: {{ komga_admin_email }}
vault_komga_admin_password: {{ komga_admin_password }}

vault_arr_radarr_api_key: {{ arr_radarr_api_key | to_json }}
vault_arr_radarr_admin_username: {{ arr_radarr_admin_username }}
vault_arr_radarr_admin_password: {{ arr_radarr_admin_password }}
vault_arr_sonarr_api_key: {{ arr_sonarr_api_key | to_json }}
vault_arr_sonarr_admin_username: {{ arr_sonarr_admin_username }}
vault_arr_sonarr_admin_password: {{ arr_sonarr_admin_password }}
vault_arr_prowlarr_api_key: {{ arr_prowlarr_api_key | to_json }}
vault_arr_prowlarr_admin_username: {{ arr_prowlarr_admin_username }}
vault_arr_prowlarr_admin_password: {{ arr_prowlarr_admin_password }}
vault_arr_bazarr_api_key: {{ arr_bazarr_api_key | to_json }}
vault_arr_bazarr_admin_username: {{ arr_bazarr_admin_username }}
vault_arr_bazarr_admin_password: {{ arr_bazarr_admin_password }}
vault_downloaders_sabnzbd_api_key: {{ downloaders_sabnzbd_api_key | to_json }}
vault_downloaders_sabnzbd_admin_username: {{ downloaders_sabnzbd_admin_username }}
vault_downloaders_sabnzbd_admin_password: {{ downloaders_sabnzbd_admin_password }}
vault_bindery_api_key: {{ bindery_api_key | to_json }}
vault_bindery_admin_username: {{ bindery_admin_username }}
vault_bindery_admin_password: {{ bindery_admin_password }}
vault_kapowarr_admin_username: {{ kapowarr_admin_username }}
vault_kapowarr_admin_password: {{ kapowarr_admin_password }}
{# ComicVine issues this key to a human account; the platform cannot generate
   one, and the vault contract refuses this stand-in until it is replaced. #}
vault_kapowarr_comicvine_api_key: replace-with-comicvine-api-key
vault_pinchflat_admin_username: {{ pinchflat_admin_username }}
vault_pinchflat_admin_password: {{ pinchflat_admin_password }}
{# WEBUI_PASSWORD is compared with bcrypt.checkpw directly and nothing hashes
   it, so the hash is what Trailarr is given and the plaintext is kept only so
   an operator and the contract can log in. #}
vault_trailarr_api_key: {{ trailarr_api_key | to_json }}
vault_trailarr_admin_username: {{ trailarr_admin_username }}
vault_trailarr_admin_password: {{ trailarr_admin_password }}
vault_trailarr_admin_password_hash: "{{ trailarr_admin_password_hash }}"
{# Seerr needs no administrator password of its own: its owner row is created
   with a Jellyfin user type and no local password, from the Jellyfin
   administrator pair above. This one key is the whole of its authentication. #}
vault_seerr_api_key: {{ seerr_api_key | to_json }}

vault_ntfy_admin_user: {{ ntfy_admin_user }}
vault_ntfy_admin_password: {{ ntfy_admin_password }}
vault_ntfy_admin_password_hash: "{{ ntfy_admin_hash }}"
vault_ntfy_dozzle_password_hash: "{{ ntfy_dozzle_hash }}"
vault_ntfy_dozzle_token: {{ ntfy_dozzle_token }}
vault_ntfy_beszel_password_hash: "{{ ntfy_beszel_hash }}"
vault_ntfy_beszel_token: {{ ntfy_beszel_token }}
vault_ntfy_deploy_password_hash: "{{ ntfy_deploy_hash }}"
vault_ntfy_deploy_token: {{ ntfy_deploy_token }}
vault_ntfy_seerr_password_hash: "{{ ntfy_seerr_hash }}"
vault_ntfy_seerr_token: {{ ntfy_seerr_token }}

vault_beszel_superuser_email: {{ beszel_superuser_email }}
vault_beszel_superuser_password: {{ beszel_superuser_password }}
vault_beszel_app_user_email: {{ beszel_app_user_email }}
vault_beszel_app_user_password: {{ beszel_app_user_password }}
vault_beszel_agent_key: "{{ beszel_agent_key }}"
vault_beszel_universal_token: {{ beszel_universal_token }}
vault_beszel_hub_private_key: |
{{ beszel_hub_private_key | indent(2, true) }}

vault_paperless_admin_username: {{ paperless_admin_username }}
vault_paperless_admin_password: {{ paperless_admin_password }}
vault_paperless_admin_email: {{ paperless_admin_email }}
vault_paperless_db_name: {{ paperless_db_name }}
vault_paperless_db_username: {{ paperless_db_username }}
vault_paperless_db_password: {{ paperless_db_password }}
vault_paperless_django_secret_key: {{ paperless_django_secret_key }}
vault_paperless_gmail_account: {{ paperless_gmail_account }}
vault_paperless_gmail_app_password: {{ paperless_gmail_app_password }}
vault_paperless_mail_account_name: {{ paperless_mail_account_name }}
vault_paperless_mail_rule_name: {{ paperless_mail_rule_name }}

# Brand-new installations start without secondary application users. Add
# reviewed identities later through the encrypted-vault workflow.
vault_managed_users:
  audiobookshelf: []
  beszel: []
  dozzle: []
  immich: []
  jellyfin: []
  komga: []
  ntfy: []
  paperless_ngx: []
