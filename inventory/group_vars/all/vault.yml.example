---
# Sanitized contract for the portable deployment vault. To recover a deployment,
# copy these exact values from the password manager and the deployed configuration;
# do not regenerate credentials already used by application or database state.
# generate-secrets.yml is only for a brand-new platform with no state to adopt.

vault_audiobookshelf_admin_username: example-admin
vault_audiobookshelf_admin_password: example-password

vault_dozzle_admin_username: example-admin
vault_dozzle_admin_password: example-password
vault_dozzle_admin_password_hash: $2b$12$00000000000000000000000000000000000000000000000000000

vault_immich_admin_email: admin@example.invalid
vault_immich_admin_password: example-password
vault_immich_db_name: example_immich
vault_immich_db_username: example_immich
vault_immich_db_password: example-password

vault_jellyfin_admin_username: Yonatan
vault_jellyfin_admin_password: example-password
vault_jellyfin_opensubtitles_username: example-opensubtitles-username
vault_jellyfin_opensubtitles_password: example-opensubtitles-password

vault_komga_admin_email: admin@example.invalid
vault_komga_admin_password: example-password

# Acquisition-service API keys are distinct 32-character lowercase hexadecimal
# values. Administrator passwords are also distinct across these five services.
# The Radarr and Sonarr keys carry one further rule, because those two are the
# ones POSTed to Bazarr's settings form: they must contain at least one a-f
# character, which is why they end in one here. Bazarr casts every submitted
# value with int() unless the last dash-segment of its key is one of config.py's
# str_keys -- `apikey` is not -- so a key of only decimal digits fails the
# schema's is_type_of str and Bazarr answers 406 for as long as it is deployed.
vault_arr_radarr_api_key: "0000000000000000000000000000000a"
vault_arr_radarr_admin_username: nasadmin
vault_arr_radarr_admin_password: example-radarr-password
vault_arr_sonarr_api_key: "1111111111111111111111111111111a"
vault_arr_sonarr_admin_username: nasadmin
vault_arr_sonarr_admin_password: example-sonarr-password
vault_arr_prowlarr_api_key: "22222222222222222222222222222222"
vault_arr_prowlarr_admin_username: nasadmin
vault_arr_prowlarr_admin_password: example-prowlarr-password
vault_arr_bazarr_api_key: "33333333333333333333333333333333"
vault_arr_bazarr_admin_username: nasadmin
vault_arr_bazarr_admin_password: example-bazarr-password
vault_downloaders_sabnzbd_api_key: "44444444444444444444444444444444"
vault_downloaders_sabnzbd_admin_username: nasadmin
vault_downloaders_sabnzbd_admin_password: example-sabnzbd-password

# Bindery's API key seeds the application's own on its first boot, which is what
# lets the platform claim the administrator account before anyone else can: the
# first-run setup route is anonymous until a user exists and refuses everyone
# afterwards. The administrator pair is stored hashed in Bindery's database and
# the application refuses a password shorter than eight characters.
vault_bindery_api_key: "55555555555555555555555555555555"
vault_bindery_admin_username: example-admin
vault_bindery_admin_password: example-bindery-password

# Kapowarr's only access control: the administrator pair it stores hashed in
# its own database and demands before it hands out its API key. The ComicVine
# key is a third-party account credential; the platform records it here and
# never generates it.
vault_kapowarr_admin_username: example-admin
vault_kapowarr_admin_password: example-kapowarr-password
vault_kapowarr_comicvine_api_key: example-comicvine-api-key

# Pinchflat's only access control: HTTP basic authentication on its web
# interface, which is the writer for the YouTube library.
vault_pinchflat_admin_username: example-admin
vault_pinchflat_admin_password: example-pinchflat-password

# ntfy tokens are tk_ plus 29 lowercase alphanumeric characters. Password
# hashes are bcrypt values produced by the pinned ntfy image.
vault_ntfy_admin_user: example-admin
vault_ntfy_admin_password: example-password
vault_ntfy_admin_password_hash: $2b$12$00000000000000000000000000000000000000000000000000000
vault_ntfy_dozzle_password_hash: $2b$12$00000000000000000000000000000000000000000000000000000
vault_ntfy_dozzle_token: tk_00000000000000000000000000000
vault_ntfy_beszel_password_hash: $2b$12$00000000000000000000000000000000000000000000000000000
vault_ntfy_beszel_token: tk_11111111111111111111111111111
vault_ntfy_deploy_password_hash: $2b$12$00000000000000000000000000000000000000000000000000000
vault_ntfy_deploy_token: tk_01010101010101010101010101010

# The Beszel hub keypair is authored before first start. The agent key contains
# only the key type and public key, without a trailing comment.
vault_beszel_superuser_email: admin@example.invalid
vault_beszel_superuser_password: example-password
vault_beszel_app_user_email: user@example.invalid
vault_beszel_app_user_password: example-password
vault_beszel_agent_key: ssh-ed25519 AAAA
vault_beszel_universal_token: 00000000-0000-4000-a000-000000000000
vault_beszel_hub_private_key: |
  -----BEGIN OPENSSH PRIVATE KEY-----
  example-only-not-a-real-private-key
  -----END OPENSSH PRIVATE KEY-----

vault_paperless_admin_username: example-admin
vault_paperless_admin_password: example-password
vault_paperless_admin_email: admin@example.invalid
vault_paperless_db_name: example_paperless
vault_paperless_db_username: example_paperless
vault_paperless_db_password: example-password
vault_paperless_django_secret_key: example-django-secret-000000000000
vault_paperless_gmail_account: gmail@example.invalid
vault_paperless_gmail_app_password: example-app-password
vault_paperless_mail_account_name: example-mail-account
vault_paperless_mail_rule_name: example-mail-rule

# Synthetic examples only. Recover deployed identities and their matching
# credentials during migration; do not use these placeholders in production.
vault_managed_users:
  audiobookshelf:
    - username: reader-example-invalid
      password: example-reader-password
      type: user
      is_active: true
      permissions:
        flags:
          accessAllLibraries: false
        librariesAccessible: []
        itemTagsSelected: []
  beszel:
    - email: reader@beszel.example.invalid
      password: example-reader-password
      role: user
      verified: true
  dozzle:
    - username: reader-example-invalid
      password: example-reader-password
      password_hash: $2b$12$11111111111111111111111111111111111111111111111111111
      email: reader@dozzle.example.invalid
      name: Synthetic Reader
      filter: ""
      roles: none
  immich:
    - email: reader@immich.example.invalid
      password: example-reader-password
      name: Synthetic Reader
      quota_size: 0
  jellyfin:
    - username: reader-example-invalid
      password: example-reader-password
      policy:
        IsAdministrator: false
        EnableAllFolders: false
  komga:
    - email: reader@komga.example.invalid
      password: example-reader-password
      roles: [PAGE_STREAMING]
  ntfy:
    - username: reader-example-invalid
      password: example-reader-password
      password_hash: $2b$12$22222222222222222222222222222222222222222222222222222
      role: user
      access:
        # ntfy runs deny-all, so a reader sees only the topics listed here, and
        # the role subscribes the account to exactly these. A topic left out is
        # a 403 on the phone, not a quiet omission.
        - topic: nas-critical
          permission: read-only
        - topic: nas-deployment
          permission: read-only
        - topic: nas-containers
          permission: read-only
      tokens: []
  paperless_ngx:
    - username: reader-example-invalid
      password: example-reader-password
      email: reader@paperless.example.invalid
      is_active: true
      is_staff: false
      is_superuser: false
      groups: []
