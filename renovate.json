{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard"
  ],
  "ignorePaths": [
    "**/node_modules/**",
    "**/bower_components/**",
    "**/vendor/**"
  ],
  "timezone": "Europe/Berlin",
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "automergeStrategy": "rebase",
  "rebaseWhen": "behind-base-branch",
  "prConcurrentLimit": 10,
  "enabledManagers": [
    "docker-compose",
    "github-actions",
    "ansible-galaxy",
    "custom.regex"
  ],
  "packageRules": [
    {
      "description": "Automerge routine non-major updates after required checks pass.",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "digest",
        "lockFileMaintenance"
      ],
      "automerge": true
    },
    {
      "matchCategories": [
        "docker"
      ],
      "pinDigests": true
    },
    {
      "description": "Immich server and machine learning must always move together.",
      "groupName": "immich",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ]
    },
    {
      "description": "The Beszel hub and both agent variants share one release train.",
      "groupName": "beszel",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/henrygd/beszel/beszel",
        "ghcr.io/henrygd/beszel/beszel-agent",
        "ghcr.io/henrygd/beszel/beszel-agent-intel"
      ]
    },
    {
      "description": "The Postgres+vector image is copied verbatim, digest included, from docker/docker-compose.yml at the pinned Immich release's git tag. Its extension versions are coupled to the Immich schema, so it follows an Immich upgrade by hand and never moves on its own.",
      "matchFileNames": [
        "services/immich/compose.yml"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/postgres"
      ],
      "enabled": false
    },
    {
      "description": "Bumping Immich also means re-copying the redis and database lines from that release's compose, and updating immich_restore_expected_immich_version plus the pinned preference schema.",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "ghcr.io/immich-app/immich-server",
        "ghcr.io/immich-app/immich-machine-learning"
      ],
      "addLabels": [
        "needs-manual-coupling"
      ],
      "automerge": false
    },
    {
      "description": "Database major versions change on-disk formats that Ansible cannot migrate.",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["docker.io/library/postgres", "docker.io/valkey/valkey"],
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    }
  ],
  "customDatasources": {
    "alpine-3.24-main": {
      "defaultRegistryUrlTemplate": "https://raw.githubusercontent.com/alpinelinux/aports/3.24-stable/main/{{packageName}}/APKBUILD",
      "format": "plain"
    }
  },
  "customManagers": [
    {
      "description": "Ansible tooling pinned in the CI workflow's pip install step.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yml$/"
      ],
      "matchStrings": [
        "'(?<depName>ansible-core|ansible-lint)==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Ansible tooling pinned in controller-requirements.txt, which the operator guide installs from. Bumped alongside ci.yml because tests/ci/workflow_test.rb requires the two to agree.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^controller-requirements\\.txt$/"
      ],
      "matchStrings": [
        "(?<depName>ansible-core|ansible-lint)==(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "datasourceTemplate": "pypi"
    },
    {
      "description": "ansible-core pinned by the integration harness.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/integration\\.sh$/"
      ],
      "matchStrings": [
        "ansible_core_version=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "ansible-core",
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Requests pinned by the integration harness.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/integration\\.sh$/"
      ],
      "matchStrings": [
        "requests_version=(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)"
      ],
      "depNameTemplate": "requests",
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Python image used by the integration sandbox and its cleanup helper. All three files must move together or cleanup pulls a second image.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/integration\\.sh$/",
        "/^tests/sandbox_cleanup\\.sh$/",
        "/^tests/integration_cleanup_test\\.sh$/"
      ],
      "matchStrings": [
        "(?:runner_image|cleanup_sandbox_image)=(?<depName>[^:\\s]+):(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})"
      ],
      "datasourceTemplate": "docker"
    },
    {
      "description": "ansible-core pinned by the Beszel telemetry test, which asserts exact ansible output.",
      "customType": "regex",
      "managerFilePatterns": [
        "/^tests/beszel_telemetry_ansible_test\\.rb$/"
      ],
      "matchStrings": [
        "REQUIRED_ANSIBLE_CORE = \"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)\""
      ],
      "depNameTemplate": "ansible-core",
      "datasourceTemplate": "pypi"
    },
    {
      "description": "Alpine ruby pinned by the integration harness. The pin uses apk's fuzzy `~` so a distro revision bump cannot drop it out of the index. Alpine's official 3.24-stable APKBUILD is the source of truth for versions available to the runner image.",
      "customType": "regex",
      "managerFilePatterns": ["/^tests/integration\\.sh$/"],
      "matchStrings": ["ruby_package='ruby~(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'"],
      "depNameTemplate": "ruby",
      "datasourceTemplate": "custom.alpine-3.24-main",
      "extractVersionTemplate": "^pkgver=(?<version>.+)$",
      "versioningTemplate": "loose"
    },
    {
      "description": "Alpine curl pinned by the integration harness. Same fuzzy-pin and official branch-tracking reasoning as the ruby manager above.",
      "customType": "regex",
      "managerFilePatterns": ["/^tests/integration\\.sh$/"],
      "matchStrings": ["curl_package='curl~(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+)'"],
      "depNameTemplate": "curl",
      "datasourceTemplate": "custom.alpine-3.24-main",
      "extractVersionTemplate": "^pkgver=(?<version>.+)$",
      "versioningTemplate": "loose"
    }
  ]
}
