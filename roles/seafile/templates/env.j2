{# Rendered at mode 0600 under no_log: this file is where seven vault
   credentials enter the target filesystem.

   The names here are the ${VAR:?} references services/seafile/compose.yml
   makes, not the variable names the containers see. Compose maps each one onto
   the Seafile-side name and documents the semantics beside it; what belongs
   here is where the value comes from.

   Compose interpolates $ in an env file and silently truncates what follows, so
   every value that can carry one is doubled. None of those truncations is loud:
   a cut database password produces a server that cannot reach its own database
   and a cut admin password produces an account nobody can log into, and neither
   says so. #}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
{# Read only by the disposable overrides, which republish the server on a
   sandbox port; the NAS compose file publishes the same number literally. #}
SEAFILE_HOST_PORT={{ seafile_port }}
SEAFILE_DATA_PATH={{ seafile_data_host_path }}
SEAFILE_DB_PATH={{ seafile_db_host_path }}
{# The address a human types, port included. Seafile builds SERVICE_URL as
   protocol://hostname and writes it into seahub_settings.py, so a hostname
   without the published port yields share links pointing at port 80 on a host
   where nothing is listening. It is deliberately not the 127.0.0.1 this role
   polls: that one is a transport coordinate for the controller, this one is
   handed to clients. #}
SEAFILE_SERVER_HOSTNAME={{ platform_public_host }}:{{ seafile_port }}
{# Signs the tokens seahub hands seaf-server. Read on every start, so this is
   one of the few Seafile credentials a rotation actually reconciles: Compose
   recreates the container and the new key is in force. #}
SEAFILE_JWT_PRIVATE_KEY={{ vault_seafile_jwt_private_key | replace('$', '$$') }}
{# The account Seafile's own setup creates and then owns. MariaDB is given no
   MYSQL_USER, so nothing but that setup ever writes this identity, and it is
   consumed while the databases are still being created. #}
SEAFILE_DB_USERNAME={{ vault_seafile_db_username | replace('$', '$$') }}
SEAFILE_DB_PASSWORD={{ vault_seafile_db_password | replace('$', '$$') }}
{# Two consumers with different lifetimes. The db container reads it as
   MYSQL_ROOT_PASSWORD on every start but MariaDB only *applies* it while the
   data directory is empty, and the server reads it as
   INIT_SEAFILE_MYSQL_ROOT_PASSWORD once, to create the three databases. So a
   rotation here changes what the container is told and not what the datadir
   stores -- which is exactly the drift tasks/deploy.yml probes for and refuses,
   rather than letting it surface later as an unexplained connection failure. #}
SEAFILE_DB_ROOT_PASSWORD={{ vault_seafile_db_root_password | replace('$', '$$') }}
{# FIRST RUN ONLY, and there is no push path.

   /scripts/start.py writes conf/admin.txt from these two on every start and
   removes it again in a finally:. check_init_admin.py consumes that file only
   when need_create_admin() is true, which is only while the user table is
   empty. So rotating vault_seafile_admin_password and converging is a silent
   no-op for as long as the account exists, and the documented remedy --
   reset-admin.sh -- is interactive and cannot be driven from a play.

   This role does not pretend otherwise. It sets the credential on first run and
   then proves it: tasks/verify.yml authenticates as exactly this pair against
   POST /api2/auth-token/, which reads ccnet_db and seahub_db, and fails naming
   both causes. Drift is loud at verification time rather than silently
   reconciled here.

   The security-boundary consequence is that conf/admin.txt materialises this
   password in plaintext inside the bind-mounted volume on every container
   start, and a container killed mid-start leaves it there. Seafile's conf/
   directory belongs on the runtime-plaintext list in CLAUDE.md beside Dozzle's
   data directory and Beszel's private key for that reason. #}
SEAFILE_ADMIN_EMAIL={{ vault_seafile_admin_email | replace('$', '$$') }}
SEAFILE_ADMIN_PASSWORD={{ vault_seafile_admin_password | replace('$', '$$') }}
{# One value, two containers: valkey requires it and seahub presents it. Read on
   every start by both, so a rotation reconciles -- the cache persists nothing,
   so there is no stored copy to diverge from. #}
SEAFILE_CACHE_PASSWORD={{ vault_seafile_cache_password | replace('$', '$$') }}
