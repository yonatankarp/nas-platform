{# AdGuard Home's ENTIRE configuration, rendered before the container's first
   start so the setup wizard never runs. Nothing is read back from the running
   service: drift made through the web interface is reverted by the next
   converge, which for this service is the desired behaviour rather than a
   compromise.

   THIS DOCUMENT IS DELIBERATELY VERBOSE, AND MUST STAY THAT WAY. AdGuard
   rewrites its own configuration file at start, expanding every default it was
   not given. Measured against v0.107.79: a 26-line minimal document came back
   as 186 lines, and the expanded form then survived a restart, a stop and a
   filter refresh byte for byte. So a short template would be rewritten on every
   first start and Ansible would report a change on every converge afterwards,
   which breaks the idempotence CLAUDE.md makes a hard requirement. What is here
   is that expanded form with the platform's own values substituted in, and it
   is stable because the daemon agrees with it exactly.

   HOW TO RE-DERIVE IT after an image bump that migrates schema_version: start
   the new image against an empty configuration directory, POST the install
   wizard, take the file it writes, restart once and confirm the file is
   unchanged, then substitute the values below back in. services/adguard/compose.yml
   records the coupling beside the pin, and renovate.json labels the bump
   `needs-manual-coupling` and refuses to automerge it -- which is not the same
   as withholding it. The pull request opens; a human is what stops it. #}
http:
  pprof:
    port: 6060
    enabled: false
  doh:
    routes:
      - GET /dns-query
      - POST /dns-query
      - GET /dns-query/{ClientID}
      - POST /dns-query/{ClientID}
    insecure_enabled: false
  address: 0.0.0.0:3000
  session_ttl: 30d
users:
  - name: {{ vault_adguard_admin_username }}
    password: {{ vault_adguard_admin_password_hash }}
auth_attempts: 5
block_auth_min: 15
http_proxy: ""
language: ""
theme: auto
dns:
  bind_hosts:
    - 0.0.0.0
  port: {{ adguard_dns_container_port }}
  anonymize_client_ip: false
{# THE RATE LIMIT IS OFF, and that is a decision rather than a default carried
through. AdGuard ships 20 queries per second counted per /24 -- both of the
lengths below are upstream's -- and this household is a single /24, so the
whole flat shares one 20 qps budget. One page load fires dozens of lookups,
and a television, a laptop and a phone waking at once would exceed it
between them while every device was behaving normally. A rate limit that
drops legitimate queries on day one is worse than no rate limit at all,
because a dropped DNS query presents as the site being broken.

What the limit is FOR is an internet-exposed resolver being conscripted into
a DNS amplification attack: a spoofed source address, a small query, a large
answer, and the victim receives the flood. That threat needs the resolver to
be reachable from the internet. This one is published on the LAN interface
of a NAS behind a Vodafone Station with no port forward to 53, and
inventory/group_vars/all/main.yml records that the operator points devices
at it by hand rather than the router handing it out.

RESTORE IT IF ANY OF THAT STOPS BEING TRUE: a port forward to 53, a router
that hands this address to a guest network, or a tailnet configuration that
makes the resolver reachable from outside the household. `ratelimit_whitelist`
is the narrower alternative -- it exempts named addresses from the limit --
and it is empty rather than populated because a limit no client is subject
to is a limit that reads as protection and is not.
tests/contracts/adguard-static.rb is where a claim about this would go.

THE COUPLING THIS FILE'S HEADER DESCRIBES STILL HOLDS, and it was re-measured
rather than reasoned about, because changing a rendered value is exactly how
that coupling would break. This whole template, rendered from the role's own
defaults, was mounted into adguard/adguardhome:v0.107.79 and came back byte
for byte identical -- across first start, a restart, and a stop -- with
`ratelimit: 0` still `ratelimit: 0`. So the second converge still reports no
change, the template task does not restart the daemon on every poller tick,
and renovate.json's paragraph about schema drift still describes the only way
that can happen. #}
  ratelimit: 0
  ratelimit_subnet_len_ipv4: 24
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist: []
  refuse_any: true
  upstream_dns:
{% for adguard_upstream in adguard_upstream_dns %}
    - {{ adguard_upstream }}
{% endfor %}
  upstream_dns_file: ""
  bootstrap_dns:
{% for adguard_bootstrap in adguard_bootstrap_dns %}
    - {{ adguard_bootstrap }}
{% endfor %}
  fallback_dns: []
  upstream_mode: load_balance
  fastest_timeout: 1s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies:
    - 127.0.0.0/8
    - ::1/128
  cache_enabled: true
  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: false
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
  bogus_nxdomain: []
  aaaa_disabled: false
  enable_dnssec: true
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: 300
  handle_ddr: true
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: 10s
  private_networks: []
  use_private_ptr_resolvers: true
  local_ptr_upstreams: []
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
  use_http3_upstreams: false
  serve_plain_dns: true
  hostsfile_enabled: true
  pending_requests:
    enabled: true
tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 853
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
  strict_sni_check: false
querylog:
  dir_path: ""
  ignored: []
  interval: 90d
  size_memory: 1000
  enabled: true
  ignored_enabled: false
  file_enabled: true
statistics:
  dir_path: ""
  ignored: []
  interval: 1d
  enabled: true
  ignored_enabled: false
filters:
{% for adguard_filter in adguard_filters %}
  - enabled: true
    url: {{ adguard_filter.url }}
    name: {{ adguard_filter.name }}
    id: {{ adguard_filter.id }}
{% endfor %}
whitelist_filters: []
user_rules: []
dhcp:
  enabled: false
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false
filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: UTC
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: false
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  rewrites: []
  safe_fs_patterns: []
  max_http_size: 256MB
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 24
  blocked_response_ttl: 10
  filtering_enabled: true
  rewrites_enabled: true
  parental_enabled: false
  safebrowsing_enabled: false
  protection_enabled: true
clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent: []
log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false
os:
  group: ""
  user: ""
  rlimit_nofile: 0
schema_version: 34
