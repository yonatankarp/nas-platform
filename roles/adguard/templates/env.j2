{# Rendered on the target at mode 0600. AdGuard reads no credential from its
   environment -- the administrator identity lives in AdGuardHome.yaml, which
   this role also renders -- so this file carries only paths, the platform
   identity, the CPU set and the host sides of the publications. #}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
NAS_UID={{ nas_uid }}
NAS_GID={{ nas_gid }}
ADGUARD_CONFIG_PATH={{ adguard_config_host_path }}
ADGUARD_WORK_PATH={{ adguard_work_host_path }}
{# Read only by services/adguard/compose.mac.yml, which replaces the production
   publications wholesale: a laptop already has a resolver on 53 and runs several
   isolated copies of the platform side by side. The production numbers are
   literals in services/adguard/compose.yml, because
   tests/media_acquisition_foundation_test.rb parses that file's published ports
   as integers. #}
ADGUARD_HOST_PORT={{ adguard_port }}
ADGUARD_DNS_HOST_PORT={{ adguard_dns_port }}
