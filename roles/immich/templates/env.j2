{# Rendered on the target. The administrator and settings are reconciled through Immich's API. #}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
NAS_DOCKER_ROOT={{ nas_docker_root }}
NAS_MEDIA_ROOT={{ nas_media_root }}
IMMICH_HOST_PORT={{ immich_port }}
IMMICH_DB_NAME={{ vault_immich_db_name }}
IMMICH_DB_USERNAME={{ vault_immich_db_username }}
{# Compose interpolates $ in env files and silently truncates an unescaped
   value rather than rejecting it, so every $ must arrive doubled. #}
IMMICH_DB_PASSWORD={{ vault_immich_db_password | replace('$', '$$') }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
