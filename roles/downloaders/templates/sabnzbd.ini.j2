__version__ = 19
__encoding__ = utf-8

[misc]
host = 0.0.0.0
port = 8080
auto_browser = 0
api_key = {{ vault_downloaders_sabnzbd_api_key }}
username = {{ vault_downloaders_sabnzbd_admin_username }}
password = {{ vault_downloaders_sabnzbd_admin_password }}
download_dir = /data/media/.acquisition/usenet/incomplete
complete_dir = /data/media/.acquisition/usenet
{# Rendered from the dict rather than key by key, because the five that used to
   be written out here were a second list of the owned settings and nothing held
   the two in step: a key added to downloaders_sabnzbd_owned_misc reconciled on
   every converge but was absent from the file a fresh host is bootstrapped with,
   so the first run after a rebuild started SABnzbd without it. That is harmless
   for a cache size and is not for script_can_fail, which is what decides whether
   an unscanned download is imported. One line per owned key, in one place. #}
{% for keyword, value in downloaders_sabnzbd_owned_misc | dictsort %}
{{ keyword }} = {{ value }}
{% endfor %}

[categories]
{% for category, directory in downloaders_sabnzbd_categories.items() %}
[[{{ category }}]]
name = {{ category }}
dir = {{ directory }}
priority = -100
pp = {{ downloaders_sabnzbd_category_post_processing }}
script = {{ downloaders_sabnzbd_category_script }}

{% endfor %}
