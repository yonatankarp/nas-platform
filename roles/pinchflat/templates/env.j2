{# Rendered on the target at mode 0600: it carries the Pinchflat basic-auth identity. #}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
NAS_UID={{ nas_uid }}
NAS_GID={{ nas_gid }}
PINCHFLAT_CONFIG_PATH={{ pinchflat_config_host_path }}
PINCHFLAT_DOWNLOADS_PATH={{ pinchflat_downloads_host_path }}
PINCHFLAT_HOST_PORT={{ pinchflat_port }}
PINCHFLAT_YTDLP_PATH={{ pinchflat_ytdlp_host_path }}
{#
  Both are doubled because Compose interpolates $ in an env file and silently
  TRUNCATES an unescaped value rather than rejecting it. The credential schema
  constrains this pair to NONEMPTY only -- no hex or length pattern -- so a
  password containing $ is legal, and unescaped it would reach the container
  shortened, leaving Pinchflat running on a password the vault does not hold.
  services/pinchflat/compose.yml records that this pair is the service's only
  access control.
#}
PINCHFLAT_BASIC_AUTH_USERNAME={{ vault_pinchflat_admin_username | replace('$', '$$') }}
PINCHFLAT_BASIC_AUTH_PASSWORD={{ vault_pinchflat_admin_password | replace('$', '$$') }}
