TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
USER_ID={{ nas_uid }}
GROUP_ID={{ nas_gid }}
DB_NAME={{ vault_paperless_db_name }}
DB_USER={{ vault_paperless_db_username }}
{# Compose interpolates $ in env files, so secret-bearing values must double it. #}
DB_PASSWORD={{ vault_paperless_db_password | replace('$', '$$') }}
PAPERLESS_SECRET_KEY={{ vault_paperless_django_secret_key | replace('$', '$$') }}
PAPERLESS_ADMIN_USER={{ vault_paperless_admin_username | replace('$', '$$') }}
PAPERLESS_ADMIN_PASSWORD={{ vault_paperless_admin_password | replace('$', '$$') }}
PAPERLESS_ADMIN_MAIL={{ vault_paperless_admin_email | replace('$', '$$') }}
PAPERLESS_TASK_WORKERS={{ paperless_task_workers }}
PAPERLESS_THREADS_PER_WORKER={{ paperless_threads_per_worker }}
{# Every platform runs the stack on its default Compose network, so the four
   dependencies are addressed by service name and none of them publishes a
   host port. #}
PAPERLESS_DBHOST=db
PAPERLESS_REDIS=redis://broker:6379
PAPERLESS_TIKA_ENDPOINT=http://tika:9998
PAPERLESS_GOTENBERG_ENDPOINT=http://gotenberg:3000
PAPERLESS_POSTGRES_PATH={{ paperless_effective_state_host_path }}/postgres
PAPERLESS_REDIS_PATH={{ paperless_effective_state_host_path }}/redis
PAPERLESS_DATA_PATH={{ paperless_effective_state_host_path }}/data
PAPERLESS_CACHE_PATH={{ paperless_effective_cache_host_path }}
PAPERLESS_TESSDATA_PATH={{ paperless_effective_state_host_path }}/tessdata
PAPERLESS_MEDIA_PATH={{ paperless_effective_archive_host_path }}
PAPERLESS_CONSUME_PATH={{ paperless_effective_consume_host_path }}
PAPERLESS_EXPORT_PATH={{ paperless_effective_export_host_path }}
PAPERLESS_HOST_PORT={{ paperless_port }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
PAPERLESS_AI_ENABLED={{ paperless_ai_enabled | bool | lower }}
PAPERLESS_AI_LLM_ENDPOINT={{ paperless_ai_llm_endpoint }}
PAPERLESS_AI_LLM_MODEL={{ paperless_ai_llm_model }}
