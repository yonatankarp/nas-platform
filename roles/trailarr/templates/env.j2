{#
  Rendered by Ansible on the target at mode 0600; never edit in place and never
  commit. It carries the Trailarr API key and the administrator's bcrypt hash.

  This is the *Compose* environment file, not the application's own
  /config/.env, and the two escape a bcrypt hash in opposite directions.
  Compose interpolates $ in an env file and silently truncates an unescaped hash
  rather than rejecting it — a raw `$zJH9U4...` expands to the empty string and
  the container starts healthy and refuses every login — so every $ is doubled
  here and Compose un-escapes it. `docker compose config` displays the escaped
  form, which is expected. /config/.env is sourced by bash instead, so there the
  same hash is single-quoted and NOT doubled; roles/trailarr/tasks/reconcile_env.yml
  is the other side of that pair.
#}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
PLATFORM_MEDIA_NETWORK={{ platform_media_control_network }}
NAS_UID={{ nas_uid }}
NAS_GID={{ nas_gid }}
TRAILARR_CONFIG_PATH={{ trailarr_config_host_path }}
TRAILARR_MOVIES_PATH={{ trailarr_movies_host_path }}
TRAILARR_SERIES_PATH={{ trailarr_series_host_path }}
TRAILARR_HOST_PORT={{ trailarr_port }}
TRAILARR_API_KEY={{ vault_trailarr_api_key }}
TRAILARR_WEBUI_USERNAME={{ vault_trailarr_admin_username }}
TRAILARR_WEBUI_PASSWORD_HASH={{ vault_trailarr_admin_password_hash | replace('$', '$$') }}
TRAILARR_MONITOR_ENABLED={{ 'True' if trailarr_monitoring_enabled | bool else 'False' }}
TRAILARR_DOWNLOADS_ENABLED={{ 'True' if trailarr_monitoring_enabled | bool else 'False' }}
