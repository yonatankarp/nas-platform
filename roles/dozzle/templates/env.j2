TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
NAS_UID={{ nas_uid }}
NAS_GID={{ nas_gid }}
DOZZLE_HOST_PORT={{ dozzle_port }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
PLATFORM_CURRENT_DIR={{ platform_current_dir }}
DOZZLE_STATE_ROOT={{ dozzle_state_root }}
ALERT_RELAY_SCRIPT_SHA256={{ dozzle_alert_relay_script.stat.checksum }}
ALERT_RELAY_TOKEN={{ vault_dozzle_alert_relay_token | replace('$', '$$') }}
ALERT_RELAY_PORT={{ dozzle_alert_relay_port }}
PUSHOVER_API_URL={{ dozzle_pushover_api_url }}
ALERT_RELAY_LINK_BASE={{ dozzle_alert_relay_link_base }}
{#
  Doubled for the reason services/ntfy/compose.yml records: Compose interpolates
  $ in an env file and truncates an unescaped value silently. Pushover issues
  30 alphanumeric characters today, but filter_plugins/vault_credential_schema.py
  deliberately refuses to assume that shape, so the escape is the only thing that
  could close it.
#}
PUSHOVER_TOKEN={{ vault_pushover_containers_token | replace('$', '$$') }}
PUSHOVER_USER_KEY={{ vault_pushover_user_key | replace('$', '$$') }}
ALERT_DAILY_CONTAINER_CEILING={{ dozzle_alert_daily_container_ceiling }}
ALERT_DAILY_OOM_CONTAINER_CEILING={{ dozzle_alert_daily_oom_container_ceiling }}
ALERT_DAILY_GLOBAL_CEILING={{ dozzle_alert_daily_global_ceiling }}
