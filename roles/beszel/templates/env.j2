{#
  Rendered by Ansible on the target; never edit in place and never commit.

  BESZEL_AGENT_KEY is the public half of the keypair written to
  /beszel_data/id_ed25519 from vault, and BESZEL_AGENT_TOKEN is an authored
  universal token. Both are known before the hub starts, so the agent needs no
  value copied out of the hub's web interface.
#}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
NAS_DOCKER_ROOT={{ nas_docker_root }}
NAS_MEDIA_ROOT={{ nas_media_root }}
NAS_RENDER_DEVICE={{ platform_render_device_path }}
{# A host without these disks gets /dev/null: the Intel agent never starts there,
   but Compose still interpolates its slots. deploy.yml refuses a NAS whose lists
   do not fill every slot, so the default cannot stand in for a real disk. #}
NAS_SMART_SATA_DEVICE_1={{ platform_smart_sata_devices[0] | default('/dev/null') }}
NAS_SMART_SATA_DEVICE_2={{ platform_smart_sata_devices[1] | default('/dev/null') }}
NAS_SMART_SATA_DEVICE_3={{ platform_smart_sata_devices[2] | default('/dev/null') }}
NAS_SMART_NVME_NAMESPACE_1={{ platform_smart_nvme_namespaces[0] | default('/dev/null') }}
NAS_SMART_NVME_NAMESPACE_2={{ platform_smart_nvme_namespaces[1] | default('/dev/null') }}
BESZEL_APP_URL={{ beszel_app_url }}
BESZEL_HOST_PORT={{ beszel_port }}
BESZEL_SYSTEM_NAME={{ beszel_system_name }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
BESZEL_AGENT_KEY={{ vault_beszel_agent_key }}
BESZEL_AGENT_TOKEN={{ vault_beszel_universal_token }}
