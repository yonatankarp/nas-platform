{#
  Rendered by Ansible on the target; never edit in place and never commit.

  BESZEL_AGENT_KEY is the public half of the keypair written to
  /beszel_data/id_ed25519 from vault, and BESZEL_AGENT_TOKEN is an authored
  universal token. Both are known before the hub starts, so the agent needs no
  value copied out of the hub's web interface.
#}
TZ={{ nas_timezone }}
NAS_DOCKER_ROOT={{ nas_docker_root }}
NAS_MEDIA_ROOT={{ nas_media_root }}
NAS_RENDER_DEVICE={{ nas_render_device }}
BESZEL_APP_URL={{ beszel_app_url }}
BESZEL_SYSTEM_NAME={{ beszel_system_name }}
BESZEL_AGENT_KEY={{ vault_beszel_agent_key }}
BESZEL_AGENT_TOKEN={{ vault_beszel_universal_token }}
