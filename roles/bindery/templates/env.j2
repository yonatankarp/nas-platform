{# Rendered on the target at mode 0600. Bindery keeps every credential in its
   own database; the only one it reads from the environment is the API-key
   seed, which is what closes the anonymous first-run setup window. #}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
PLATFORM_MEDIA_NETWORK={{ platform_media_control_network }}
NAS_UID={{ nas_uid }}
NAS_GID={{ nas_gid }}
BINDERY_API_KEY={{ vault_bindery_api_key }}
BINDERY_CONFIG_PATH={{ bindery_config_host_path }}
BINDERY_BOOKS_PATH={{ bindery_books_host_path }}
BINDERY_MEDIA_PATH={{ bindery_media_host_path }}
BINDERY_HOST_PORT={{ bindery_port }}
