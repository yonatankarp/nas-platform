{# Rendered at mode 0600 under no_log: two vault credentials enter the target
   filesystem here. Both are 64 lowercase hex by the vault contract, so neither
   can carry the `$` Compose would interpolate or a newline that would truncate
   the line. #}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
{# Read only by the Mac override; the canonical file publishes 8087 literally. #}
KARAKEEP_HOST_PORT={{ karakeep_port }}
KARAKEEP_DATA_PATH={{ karakeep_data_host_path }}
KARAKEEP_MEILISEARCH_PATH={{ karakeep_meilisearch_host_path }}
KARAKEEP_NEXTAUTH_URL={{ karakeep_nextauth_url }}
KARAKEEP_NEXTAUTH_SECRET={{ vault_karakeep_nextauth_secret }}
KARAKEEP_MEILI_MASTER_KEY={{ vault_karakeep_meili_master_key }}
{# The door, and the only two lines that differ between the bootstrap phase and
   every other converge. karakeep_bootstrap_open is set by tasks/bootstrap.yml
   alone, for the one request that registers the administrator, and set back
   before that task file ends: signups open ONLY while the listener is on
   loopback. #}
KARAKEEP_DISABLE_SIGNUPS={{ 'false' if karakeep_bootstrap_open | default(false) | bool else 'true' }}
KARAKEEP_PUBLISH_ADDRESS={{ '127.0.0.1' if karakeep_bootstrap_open | default(false) | bool else karakeep_publish_address }}
