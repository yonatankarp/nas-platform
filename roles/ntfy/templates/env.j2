{#
  Rendered by Ansible on the target; never edit in place and never commit.

  Bcrypt hashes contain $, which Compose interpolates in both --env-file and
  service-level env_file, silently truncating an unescaped hash rather than
  rejecting it. Every $ is therefore doubled here; Compose un-escapes it and the
  container receives the real hash. `docker compose config` displays the escaped
  form, which is expected.
#}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
NAS_UID={{ nas_uid }}
NAS_GID={{ nas_gid }}
NAS_DOCKER_ROOT={{ nas_docker_root }}
NTFY_BASE_URL={{ ntfy_base_url }}
NTFY_HOST_PORT={{ ntfy_port }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
NTFY_AUTH_USERS={{ ntfy_auth_users | replace('$', '$$') }}
NTFY_AUTH_ACCESS={{ ntfy_auth_access }}
NTFY_AUTH_TOKENS={{ ntfy_auth_tokens }}
