{#
  Rendered by Ansible on the target at mode 0600; never edit in place and never
  commit. It carries the Seerr API key.

  The key is the whole of Seerr's authentication and it is genuinely one-way:
  the application reads API_KEY on every start, takes it as its own on a virgin
  configuration, and overwrites a stored value that has drifted. So nothing is
  ever read back, and a key rotated from the web interface with
  POST /api/v1/settings/main/regenerate is replaced by this one at the next
  container start.
#}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
PLATFORM_MEDIA_NETWORK={{ platform_media_control_network }}
NAS_UID={{ nas_uid }}
NAS_GID={{ nas_gid }}
SEERR_CONFIG_PATH={{ seerr_config_host_path }}
SEERR_HOST_PORT={{ seerr_port }}
SEERR_API_KEY={{ vault_seerr_api_key }}
