{# Rendered on the target at mode 0600. Kapowarr keeps every credential in its
   own database and reads none from the environment, so this file carries only
   paths, the platform identity and the CPU set. #}
TZ={{ nas_timezone }}
PLATFORM_CONTAINER_CPUSET={{ platform_effective_container_cpuset }}
PLATFORM_PROJECT_NAME={{ platform_project_name | default('') }}
NAS_UID={{ nas_uid }}
NAS_GID={{ nas_gid }}
KAPOWARR_CONFIG_PATH={{ kapowarr_config_host_path }}
{# One bind mount of the whole Books share, not one per leaf: the comics library
   and its staging directory have to sit inside a single mount or every import is
   a cross-device copy. The two container paths below that mount are declared in
   the role's defaults and stored by the application, not read from here. #}
KAPOWARR_BOOKS_PATH={{ kapowarr_books_host_path }}
KAPOWARR_HOST_PORT={{ kapowarr_port }}
